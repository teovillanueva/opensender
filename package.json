{
  "name": "opensender",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "depcruise": "depcruise packages",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm knip && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@sentry/esbuild-plugin": "^5.4.0",
    "dependency-cruiser": "18.1.1",
    "knip": "6.32.0",
    "sst": "4.17.1",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
